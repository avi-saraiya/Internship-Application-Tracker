# Copy to .env and adjust. Never commit .env.

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker_dev_password
POSTGRES_DB=tracker

# Backend (host-native runs; docker-compose overrides the host to "db")
DATABASE_URL=postgresql+psycopg://tracker:tracker_dev_password@localhost:5432/tracker
TEST_DATABASE_URL=postgresql+psycopg://tracker:tracker_dev_password@localhost:5432/tracker_test

# Session cookie: set SESSION_COOKIE_SECURE=true when served over HTTPS
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
